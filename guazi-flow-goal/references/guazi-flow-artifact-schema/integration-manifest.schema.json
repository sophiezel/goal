{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "integration-manifest",
  "description": "Federation SSOT for multi-goal cross_app checks (optional)",
  "type": "object",
  "required": ["schema_version", "project_roots"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "project_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "project_root"],
        "properties": {
          "id": { "type": "string" },
          "project_root": { "type": "string" },
          "guazi_flow_task": { "type": "string" }
        }
      }
    },
    "cross_app": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_project", "to_project", "path", "query"],
        "properties": {
          "from_project": { "type": "string" },
          "to_project": { "type": "string" },
          "path": { "type": "string" },
          "query": { "type": "array", "items": { "type": "string" } },
          "from_scan_globs": { "type": "array", "items": { "type": "string" } },
          "to_scan_globs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
