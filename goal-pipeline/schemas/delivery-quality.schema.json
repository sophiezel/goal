{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "delivery-quality",
  "description": "complete 阶段交付质量报告（v3 §0 节点 I/O 契约）",
  "type": "object",
  "required": ["schema_version", "task_dir", "computed_at", "chain_complete", "leak_rate", "gate_status"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task_dir": { "type": "string" },
    "computed_at": { "type": "string", "format": "date-time" },
    "chain_complete": {
      "type": "object",
      "description": "各节点 handoff 是否齐备",
      "properties": {
        "plan": { "type": "boolean" },
        "implement": { "type": "boolean" },
        "quality": { "type": "boolean" },
        "review": { "type": "boolean" },
        "complete": { "type": "boolean" }
      }
    },
    "leak_rate": {
      "type": "number",
      "description": "本任务 escapes / 1（单任务为 0 或 1）",
      "minimum": 0,
      "maximum": 1
    },
    "gate_status": {
      "type": "string",
      "enum": ["OK", "BLOCK"],
      "description": "chain_complete 全 true 且 leak_rate=0 → OK"
    },
    "stages_summary": {
      "type": "object",
      "description": "每节点 gate.passed_at 与 exit_code",
      "properties": {
        "plan": { "type": "object" },
        "implement": { "type": "object" },
        "quality": { "type": "object" },
        "review": { "type": "object" },
        "complete": { "type": "object" }
      }
    },
    "task_tier": { "type": "string", "enum": ["XS", "S", "M", "L", "XL"] },
    "plan_profile": { "type": "string", "enum": ["lite", "full"] },
    "review_track": { "type": "string", "enum": ["single", "dual"] }
  }
}
