{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "delivery-quality",
  "description": "complete 阶段交付质量报告（Pipeline I/O Port Spec）",
  "type": "object",
  "required": ["schema_version", "task_dir", "computed_at", "chain_complete", "leak_rate", "gate_status"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1, 2] },
    "pipeline_id": { "type": "string", "enum": ["goal-pipeline", "guazi-flow-goal", ""] },
    "task_dir": { "type": "string" },
    "computed_at": { "type": "string", "format": "date-time" },
    "chain_complete": {
      "type": "object",
      "properties": {
        "plan": { "type": "boolean" },
        "implement": { "type": "boolean" },
        "quality": { "type": "boolean" },
        "review": { "type": "boolean" },
        "complete": { "type": "boolean" }
      }
    },
    "leak_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "gate_status": { "type": "string", "enum": ["OK", "BLOCK"] },
    "stages_summary": { "type": "object" },
    "task_tier": { "type": "string", "enum": ["XS", "S", "M", "L", "XL", ""] },
    "plan_profile": { "type": "string", "enum": ["lite", "full", ""] },
    "review_track": { "type": "string", "enum": ["single", "dual", ""] },
    "timing": {
      "type": "object",
      "properties": {
        "plan_ms": { "type": "number" },
        "implement_ms": { "type": "number" },
        "quality_ms": { "type": "number" },
        "review_ms": { "type": "number" },
        "total_ms": { "type": "number" },
        "source": { "type": "string" }
      }
    },
    "review_provenance": {
      "type": "object",
      "properties": {
        "model_invocations": { "type": "integer" },
        "latency_ms": { "type": "number" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "channels_used": { "type": "array", "items": { "type": "string" } },
        "issues_goal": { "type": "integer" },
        "issues_gf": { "type": "integer" }
      }
    },
    "loops": {
      "type": "object",
      "properties": {
        "review_rounds": { "type": "integer" },
        "replan_count": { "type": "integer" },
        "stagnant_blocked": { "type": "boolean" },
        "final_action": { "type": "string" },
        "first_pass": { "type": "boolean" }
      }
    },
    "quality_summary": {
      "type": "object",
      "properties": {
        "blocker_count_final": { "type": "integer" },
        "leak_rate": { "type": "number" },
        "handoff_coverage": { "type": "number" }
      }
    },
    "gate_evidence_rollup": {
      "type": "array",
      "description": "Generic rollup of gate outcome JSON in evidence/ (any file with top-level passed)",
      "items": {
        "type": "object",
        "required": ["artifact", "passed", "issue_count"],
        "properties": {
          "artifact": { "type": "string" },
          "passed": { "type": "boolean" },
          "skipped": { "type": ["boolean", "null"] },
          "issue_count": { "type": "integer" }
        }
      }
    }
  }
}
