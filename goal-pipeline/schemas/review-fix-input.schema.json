{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "goal-pipeline/schemas/review-fix-input.schema.json",
  "title": "Review kernel B — review-fix-input contract",
  "description": "Execution-agent contract for review fix loop (merge-review-issues output)",
  "type": "object",
  "required": [
    "schema_version",
    "round",
    "merged_result",
    "action",
    "issues",
    "next_steps",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "round": { "type": "integer", "minimum": 1 },
    "merged_result": { "type": "string", "enum": ["pass", "not_pass"] },
    "action": {
      "type": "string",
      "enum": [
        "proceed_complete",
        "fix_and_rerun_review",
        "mini_replan",
        "blocked_user_decision",
        "blocked_stagnant",
        "switch_to_cursor_task",
        "fix_channel"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "channel", "severity", "summary"],
        "properties": {
          "id": { "type": "string" },
          "channel": {
            "type": "string",
            "enum": ["goal", "guazi-flow-review"]
          },
          "severity": {
            "type": "string",
            "enum": ["blocker", "warning", "medium", "high", "critical"]
          },
          "summary": { "type": "string" },
          "file": { "type": "string" },
          "line_range": { "type": "string" },
          "suggestion": { "type": "string" },
          "root_cause": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "resolved_since_last_round": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_steps": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "provenance": {
      "type": "object",
      "required": ["review_run_id", "packet_hash"],
      "properties": {
        "review_run_id": { "type": "string" },
        "packet_hash": { "type": "string" },
        "gf_skill_attested": { "type": "boolean" },
        "channels": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "classification": {
      "type": "string",
      "enum": ["business", "infra_undetermined"]
    },
    "max_rounds": { "type": "integer", "minimum": 1 },
    "rounds_exhausted": { "type": "boolean" },
    "blocker_count": { "type": "integer", "minimum": 0 },
    "info_gain": { "type": "number" },
    "info_gain_threshold": { "type": "number" },
    "stagnant_rounds": { "type": "integer", "minimum": 0 },
    "stagnant_rounds_limit": { "type": "integer", "minimum": 1 },
    "stagnant_blocked": { "type": "boolean" }
  },
  "additionalProperties": true
}
